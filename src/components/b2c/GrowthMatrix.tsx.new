  red: tx('Рутинный ввод данных, поиск информации, механическая проверка, шаблонные тексты и повторяемые действия.','Routine data entry, information search, mechanical checking, template writing and repetitive actions.','Дерек енгізу, ақпарат іздеу, механикалық тексеру, шаблондық мәтіндер және қайталанатын әрекеттер.','Məlumatların daxil edilməsi, informasiya axtarışı, mexaniki yoxlama, şablon mətnlər və təkrarlanan hərəkətlər.'),
  green: tx('Критическое мышление, переговоры, причинно-следственный анализ, ответственность за результат, доменная экспертиза и системное мышление.','Critical thinking, negotiation, causal analysis, outcome ownership, domain expertise and systems thinking.','Сыни ойлау, келіссөздер, себеп-салдар талдауы, нәтиже үшін жауапкершілік, домендік сараптама және жүйелік ойлау.','Tənqidi düşüncə, danışıqlar, səbəb-nəticə analizi, nəticəyə görə məsuliyyət, domen ekspertizası və sistemli düşüncə.'),
  blue: tx('Работа в связке с AI, постановка задач агентам, проверка AI-результата, управление контекстом и проектирование новых способов работы.','Working with AI, delegating to agents, validating AI output, managing context and designing new ways of working.','AI-мен бірлесіп жұмыс істеу, агенттерге міндет қою, AI нәтижесін тексеру, контекстті басқару және жаңа жұмыс тәсілдерін жобалау.','AI ilə işləmək, agentlərə tapşırıq vermək, AI nəticəsini yoxlamaq, konteksti idarə etmək və yeni iş üsullarının dizaynı.')
 }
};

const aliases: Array<[Direction, RegExp]> = [
 ['marketing', /маркет|marketing|маркетолог|marketing/],
 ['it', /разраб|developer|програм|software|data engineer|devops|qa|тест|it|әзір|бағдарлам|inkişaf|proqram/],
 ['hr', /\bhr\b|персон|кадр|рекрут|talent|human resources|адам ресур|insan resurs/],
 ['finance', /финанс|бух|эконом|finance|account|қаржы|есеп|maliyy|mühasib/],
 ['product', /продакт|product|продукт|cpo|өнім|məhsul/],
 ['operations', /операц|operations|project manager|проект|pm|delivery|procurement|логист|ops|операция|жоба|əməliyyat|layihə/],
 ['analytics', /аналит|analytics|data analyst|bi |research|зертте|analitika|təhlil/],
 ['design', /дизайн|designer|ux|ui|graphic|motion|дизайнер|дизайн|dizayn/],
 ['customer_success', /customer success|клиентск|аккаунт|support|поддерж|cx|cs|клиент|клиенттер|müştəri/],
 ['management', /руковод|директор|manager|management|head|lead|ceo|cfo|cto|coo|басқар|менеджмент|rəhbər|idarə/],
 ['legal', /юрист|legal|law|compliance|право|юриспруд|заң|hüquq|compliance/],
 ['sales', /продаж|sales|seller|account executive|business development|bdm|сату|сатылым|satış/]
];

function detectDirection(role: string): Direction {
 const value = role.trim().toLowerCase();
 if (!value) return 'universal';
 for (const [key, pattern] of aliases) if (pattern.test(value)) return key;
 return 'universal';
}

export default function GrowthMatrix({ lang, role, bottleneck }: Props) {
 const u = ui[lang];
 const detected = useMemo(() => detectDirection(role), [role]);
 const [selected, setSelected] = useState<Direction>(detected);
 const key = matrix[selected] ? selected : 'universal';
 const m = matrix[key];
 const [active, setActive] = useState<'red' | 'green' | 'blue'>('green');
 const labels = { red: u.red, green: u.green, blue: u.blue };

 return (
  <section className="mt-6 rounded-2xl border border-slate-200 p-5 sm:p-7" aria-label={u.title}>
   <h2 className="text-2xl font-bold">{u.title}</h2>
   <p className="mt-2 leading-7 text-slate-600">{u.intro}</p>

   <div className="mt-5 flex flex-wrap items-center gap-2">
    <span className="text-sm font-semibold text-slate-500">{u.choose}:</span>
    {Object.keys(matrix).filter(k => k !== 'universal').map(k => (
     <button key={k} type="button" onClick={() => setSelected(k as Direction)} className={`rounded-full border px-3 py-1.5 text-xs font-semibold ${key === k ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-200 bg-white text-slate-600'}`}>
      {k === 'customer_success' ? 'Customer Success' : k === 'operations' ? 'Project / Operations' : k === 'it' ? 'IT' : k.charAt(0).toUpperCase() + k.slice(1)}
     </button>
    ))}
   </div>

   {key === 'universal' && <div className="mt-3 rounded-xl bg-slate-50 p-3 text-sm text-slate-600">{u.universal}</div>}

   <div className="mt-5 grid gap-3 md:grid-cols-3">
    {(['red', 'green', 'blue'] as const).map(k => (
     <button key={k} type="button" onClick={() => setActive(k)} aria-pressed={active === k} className={`rounded-xl border p-4 text-left transition ${active === k ? 'border-slate-900 bg-slate-50' : 'border-slate-200 bg-white hover:bg-slate-50'}`}>
      <div className="text-sm font-bold">{labels[k]}</div>
      <p className="mt-2 text-sm leading-6 text-slate-600">{m[k][lang]}</p>
     </button>
    ))}
   </div>

   <div className="mt-5 rounded-xl bg-slate-50 p-5">
    <div className="font-semibold">{labels[active]}</div>
    <p className="mt-2 leading-7 text-slate-700">{m[active][lang]}</p>
   </div>

   {bottleneck?.name && (
    <div className="mt-5 rounded-xl border border-slate-200 p-5">
     <div className="text-sm font-semibold text-slate-500">{u.bottleneck}</div>
     <div className="mt-1 font-bold">{bottleneck.name}</div>
     <p className="mt-2 text-sm leading-6 text-slate-600">{m.green[lang]}</p>
    </div>
   )}

   <div className="mt-5 rounded-xl border border-slate-200 p-5">
    <div className="font-semibold">{u.plan}</div>
    <div className="mt-4 grid gap-3">
     <div><span className="font-semibold">{u.d1.split(':')[0]}:</span> {u.d1.split(':').slice(1).join(':').trim()}</div>
     <div><span className="font-semibold">{u.d2.split(':')[0]}:</span> {u.d2.split(':').slice(1).join(':').trim()}</div>
     <div><span className="font-semibold">{u.d3.split(':')[0]}:</span> {u.d3.split(':').slice(1).join(':').trim()}</div>
    </div>
   </div>

   {!role.trim() && <p className="mt-4 text-sm text-slate-500">{u.empty}</p>}
  </section>
 );
}
